{
  "name": "disney-hotel-reservation",
  "version": "0.1.0",
  "private": true,
  "description": "東京ディズニーリゾート(TDR)直営ホテルの予約状況を定期取得してメール通知するツール",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "tsx src/index.ts",
    "setup": "tsx src/index.ts --setup",
    "reset": "tsx src/index.ts --reset",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "handlebars": "^4.7.8",
    "linkedom": "^0.18.0",
    "nodemailer": "^8.0.7",
    "playwright": "^1.49.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/nodemailer": "^6.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.7"
  }
}
